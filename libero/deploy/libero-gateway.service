[Unit]
Description=LIBERO Agent HTTP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=libero-service
Group=libero-service
WorkingDirectory=/opt/libero-agent-gateway
EnvironmentFile=/etc/libero-gateway/environment
ExecStart=/opt/libero-agent-gateway/venv/bin/libero-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/libero-agent-gateway
ReadOnlyPaths=/opt/libero-robot-fork
ReadWritePaths=/var/lib/libero-gateway
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
TasksMax=8192
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
