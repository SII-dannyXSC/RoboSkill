HOME=/var/lib/libero-gateway
XDG_CACHE_HOME=/var/lib/libero-gateway/cache
LIBERO_CONFIG_PATH=/var/lib/libero-gateway/libero-config
LIBERO_GATEWAY_BACKEND=libero
LIBERO_GATEWAY_HOST=127.0.0.1
LIBERO_GATEWAY_PORT=18080
LIBERO_GATEWAY_GPU_IDS=0
LIBERO_GATEWAY_MAX_SESSIONS_PER_GPU=1
LIBERO_GATEWAY_PROCESS_START_TIMEOUT=180
LIBERO_GATEWAY_REQUEST_TIMEOUT=120
LIBERO_GATEWAY_SESSION_IDLE_SECONDS=21600
LIBERO_GATEWAY_DEFAULT_EPISODE_STEPS=1000
LIBERO_GATEWAY_MAX_EPISODE_STEPS=2000
LIBERO_GATEWAY_IMAGE_HEIGHT=128
LIBERO_GATEWAY_IMAGE_WIDTH=128
LIBERO_GATEWAY_JPEG_QUALITY=90
LIBERO_GATEWAY_AGENTS_FILE=/etc/libero-gateway/agents.json
LIBERO_GATEWAY_AUDIT_LOG=/var/lib/libero-gateway/audit.jsonl
LIBERO_GATEWAY_EVALUATIONS_DB=/var/lib/libero-gateway/evaluations.sqlite3
LIBERO_GATEWAY_LOG_LEVEL=info
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl
PYTHONUNBUFFERED=1
