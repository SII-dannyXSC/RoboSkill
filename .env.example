# Public deployment defaults only. Copy to .env or export values in your shell.
LIBERO_API_URL=http://127.0.0.1:18080
LIBERO_API_TOKEN=replace-with-a-local-token
LIBERO_GATEWAY_GPU_IDS=0
LIBERO_GATEWAY_MAX_SESSIONS_PER_GPU=1
LIBERO_SOURCE_DIR=third_party/LIBERO

# The native Agent CLIs are authenticated outside this repository.
CODEX_EXECUTABLE=codex
CODEX_AUTH_FILE=~/.codex/auth.json
CLAUDE_EXECUTABLE=claude
